# ============================================================
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ============================================================
# Editor / IDE
# ============================================================
.vscode/
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~

# ============================================================
# Claude Code
# ============================================================
.claude/settings.local.json

# ============================================================
# Flutter / Dart  (app/ already has its own .gitignore)
# ============================================================
**/doc/api/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
app/.metadata

# build_runner generated files
*.g.dart
*.freezed.dart
*.mocks.dart
*.gen.dart

# ============================================================
# Python / FastAPI
# ============================================================
__pycache__/
*.py[cod]
*.pyo
.env
.env.*
!.env.example
venv/
.venv/
*.egg-info/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# Docker
# ============================================================
.env.local
docker-compose.override.yml

# ============================================================
# Large data files (MOTIS / Overpass / GTFS)
# ============================================================
backend/motis/data/**
!backend/motis/data/.gitkeep
backend/overpass/data/**
!backend/overpass/data/.gitkeep

# OSM / GTFS raw data anywhere in the tree
*.osm
*.osm.pbf
*.pbf
*.zip
*.gtfs

# ============================================================
# Logs & temp
# ============================================================
*.log
logs/
tmp/
temp/
