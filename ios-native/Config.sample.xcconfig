// Copy this file to Config.xcconfig (gitignored) and point BACKEND_BASE_URL
// at your own backend instance. See backend/docker-compose.yml for running
// the FastAPI + MOTIS + Overpass stack locally.
//
// Xcconfig treats "//" anywhere in a line as the start of a comment —
// even a "//" produced later by macro expansion doesn't help, because
// comment-stripping happens on the raw line text before "$()" is
// expanded. The fix is to put "$()" *between* the two slash characters
// so the raw text never contains a literal "//" substring at all.
BACKEND_BASE_URL = http:/$()/localhost:8000

// Your Apple ID's Team ID (Xcode > Settings > Accounts > select your
// Apple ID > "Team" column, or developer.apple.com > Account > Membership
// details). Setting this here — instead of only picking a Team in
// Xcode's Signing & Capabilities tab — means the choice survives
// `xcodegen generate` regenerating the .xcodeproj from scratch, which
// happens whenever a file is added/removed or project.yml changes. Leave
// this blank to keep picking a Team manually in Xcode each time.
DEVELOPMENT_TEAM =
